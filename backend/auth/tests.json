{
  "tests": [
    {
      "name": "Проверка сессии без токена",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 200
    },
    {
      "name": "Неверный логин",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "username": "nobody", "password": "wrong"},
      "expectedStatus": 401
    },
    {
      "name": "Выгрузка без входа запрещена",
      "method": "POST",
      "path": "/",
      "body": {"action": "export"},
      "expectedStatus": 401
    }
  ]
}